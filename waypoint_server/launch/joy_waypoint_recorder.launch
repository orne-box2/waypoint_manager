<?xml version="1.0"?>
<launch>
  <!-- Reuse running localization/teleop if present. Do not run the old
       record_waypoints_joy_* launch alongside this: it has a separate saver
       and a different YAML format. Disable server below if already running. -->
  <arg name="launch_nav" default="true"/>
  <arg name="launch_waypoint_server" default="true"/>
  <arg name="launch_teleop" default="true"/>
  <arg name="config_file" default="$(find waypoint_server)/config/waypoint_server.yaml"/>
  <arg name="joy_config" default="elecom_joy"/>
  <arg name="joy_dev" default="/dev/input/js0"/>
  <arg name="joy_topic" default="/joy"/>
  <arg name="map_frame" default="map"/>
  <arg name="robot_frame" default="base_link"/>

  <!-- User-reported layout: down=0 (normal), right=1 (goal), left=2 (pause),
       up=3 (unused). Verify with /joy; override indices as needed; -1 disables.
       Goal: final stop=true point, then recording ends (restart for a new session).
       Pause: stop=true point, recording continues. RViz property editing remains.
       The existing server/YAML format has no dedicated goal property. -->
  <arg name="register_button" default="0"/>
  <arg name="goal_button" default="-1"/>
  <arg name="pause_button" default="1"/>
  <arg name="cooldown_sec" default="1.0"/>
  <arg name="wait_new_id_timeout" default="5.0"/>
  <arg name="max_tf_age" default="1.0"/>
  <!-- elecom teleop publishes at autorepeat_rate=20. Set timeout to 0 for
       event-only Joy publishers; first message still only initializes input. -->
  <arg name="joy_reconnect_timeout" default="2.0"/>
  <arg name="update_waypoint_topic" default="/waypoint_manager/waypoint/update"/>
  <arg name="waypoints_topic" default="/waypoint_manager/waypoints"/>
  <arg name="append_route_topic" default="/waypoint_manager/route/append"/>
  <arg name="route_topic" default="/waypoint_manager/route"/>

  <!-- Deprecated: accepted for old callers, always ignored by the recorder.
       Neither auto_save=true nor any button can save or start driving. -->
  <arg name="save_button" default="-1"/>
  <arg name="start_button" default="-1"/>
  <arg name="auto_save" default="false"/>

  <group if="$(arg launch_teleop)">
    <remap from="joy" to="$(arg joy_topic)"/>
    <include file="$(find icart_mini_driver)/launch/teleop_joy.launch">
      <arg name="joy_config" value="$(arg joy_config)"/>
      <arg name="joy_dev" value="$(arg joy_dev)"/>
    </include>
  </group>
  <include if="$(arg launch_waypoint_server)"
           file="$(find waypoint_server)/launch/waypoint_server_options.launch">
    <arg name="config_file" value="$(arg config_file)"/>
    <!-- Recording needs no autonomous recovery or driving reconfiguration. -->
    <arg name="use_check_robot_moving" value="false"/>
    <arg name="use_waypoint_reconfigure" value="false"/>
  </include>
  <include if="$(arg launch_nav)"
           file="$(find orne_box_navigation_executor)/launch/play_waypoints_nav_box.launch"/>

  <!-- Execute from the source workspace without changing CMake/package.xml. -->
  <node pkg="waypoint_server" type="joy_waypoint_recorder.py"
        name="joy_waypoint_recorder" output="screen" launch-prefix="/usr/bin/python3">
    <param name="joy_topic" value="$(arg joy_topic)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="robot_frame" value="$(arg robot_frame)"/>
    <param name="register_button" type="int" value="$(arg register_button)"/>
    <param name="goal_button" type="int" value="$(arg goal_button)"/>
    <param name="pause_button" type="int" value="$(arg pause_button)"/>
    <param name="cooldown_sec" type="double" value="$(arg cooldown_sec)"/>
    <param name="wait_new_id_timeout" type="double" value="$(arg wait_new_id_timeout)"/>
    <param name="max_tf_age" type="double" value="$(arg max_tf_age)"/>
    <param name="joy_reconnect_timeout" type="double" value="$(arg joy_reconnect_timeout)"/>
    <param name="update_waypoint_topic" value="$(arg update_waypoint_topic)"/>
    <param name="waypoints_topic" value="$(arg waypoints_topic)"/>
    <param name="append_route_topic" value="$(arg append_route_topic)"/>
    <param name="route_topic" value="$(arg route_topic)"/>
    <param name="save_button" type="int" value="$(arg save_button)"/>
    <param name="start_button" type="int" value="$(arg start_button)"/>
    <param name="auto_save" type="bool" value="$(arg auto_save)"/>
  </node>
</launch>

